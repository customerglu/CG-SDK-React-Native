{
  "name": "@customerglu/react-native-customerglu",
  "version": "1.0.0",
  "description": "React Native SDK for CustomerGlu with New Architecture support",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it",
    "bootstrap": "cd example && npm install",
    "verify-migration": "node scripts/verify-migration.js",
    "setup-dev": "node scripts/setup-dev-environment.js",
    "generate-codegen": "node scripts/generate-codegen.js",
    "test-migration": "node scripts/test-migration.js",
    "example": "cd example && npm start",
    "pods": "cd example/ios && pod install",
    "build:android": "cd example/android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "cd example/ios && xcodebuild -workspace RncustomergluExample.xcworkspace -scheme RncustomergluExample -configuration Debug -sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO"
  },
  "keywords": [
    "react-native",
    "customerglu",
    "sdk",
    "turbomodule",
    "fabric"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/customerglu/CG-SDK-React-Native.git"
  },
  "author": "CustomerGlu <support@customerglu.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/customerglu/CG-SDK-React-Native/issues"
  },
  "homepage": "https://github.com/customerglu/CG-SDK-React-Native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "^0.73.1",
    "@react-native/eslint-config": "^0.73.1",
    "@react-native/metro-config": "^0.73.1",
    "@react-native/typescript-config": "^0.73.1",
    "@release-it/conventional-changelog": "^5.0.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.3.18",
    "@types/react-native": "^0.72.8",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "chalk": "^4.1.2",
    "del-cli": "^5.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.2.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.8.8",
    "react": "18.2.0",
    "react-native": "0.73.1",
    "react-native-builder-bob": "^0.20.0",
    "react-test-renderer": "18.2.0",
    "release-it": "^15.0.0",
    "typescript": "^5.7.3"
  },
  "resolutions": {
    "@types/react": "^18.2.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@customerglu)/)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
